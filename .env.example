PORT=4020
DATABASE_URL=postgresql://user:password@localhost:5432/triostack_users
# Set true for managed/remote PostgreSQL (certificate + hostname are verified). DATABASE_SSL_CA is optional (PEM, \n-escaped).
DATABASE_SSL=false
NODE_ENV=development
LOG_LEVEL=info
MAX_PAGE_SIZE=100
DB_POOL_MAX=20
REQUEST_TIMEOUT_MS=10000
# Idempotency-Key retention window (hours)
IDEMPOTENCY_TTL_HOURS=24
# Per-actor limit for create/status/delete, and per-IP limit for everything (requests per minute)
RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=600
# Number of reverse-proxy hops in front of the service (1 behind Caddy/nginx/ALB)
TRUST_PROXY=0

# ---- Authentication ----
# jwt    : signed tokens carry tenant/org/actor/roles. REQUIRED in production (default when NODE_ENV=production).
# static : shared BRR token + trusted X-* headers. Local/dev only.
AUTH_MODE=static
# static mode:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRR_TOKEN=<secret-from-secret-manager>
# jwt mode: HS256 secret (>=32 chars) OR an RS256/ES256 public key (PEM, \n-escaped). Issuer/audience are mandatory.
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ISSUER=triostack-auth
JWT_AUDIENCE=triostack-user-service
# Escape hatch: allow static auth with NODE_ENV=production (only behind a trusted gateway). Avoid.
ALLOW_INSECURE_STATIC_AUTH=false
